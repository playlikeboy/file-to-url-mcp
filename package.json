{
  "name": "file-to-url-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server on Cloudflare Workers that turns any file into a short, temporary public download link (stored on UploadThing).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "wrangler d1 migrations apply file2url --remote",
    "db:migrate:local": "wrangler d1 migrations apply file2url --local"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
